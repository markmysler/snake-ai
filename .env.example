# Copy to .env (git-ignored) to enable the AI run analysis. Set the key of either provider, or both.
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=
# Optional: which provider to use when both have a key (tokenrouter or openrouter; default tokenrouter)
# SNAKE_AI_LLM_PROVIDER=openrouter
# Optional: which model analyses runs (default anthropic/claude-haiku-5.5; the same id works on both)
# SNAKE_AI_LLM_MODEL=anthropic/claude-sonnet-5.5
# Optional: another endpoint for a provider (any OpenAI-compatible API works as "tokenrouter")
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
